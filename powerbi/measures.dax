// DAX measures for the Retail Analytics model. Generated by scripts/export_powerbi.py.
// In the browser: open the semantic model > Open data model > select the home table > New measure,
// then paste one block at a time (name = expression). Set the format shown in the comment.

// ===== Sales =====
// Gross product sales in GBP (cancellations excluded).  |  home table: fact_sales  |  format: £#,0
Revenue =
    CALCULATE(SUM(fact_sales[revenue]), fact_sales[is_cancellation] = FALSE())

// Distinct sales invoices.  |  home table: fact_sales  |  format: #,0
Orders =
    CALCULATE(DISTINCTCOUNT(fact_sales[invoice]), fact_sales[is_cancellation] = FALSE())

// Distinct identified customers; guest lines have no customer ID.  |  home table: fact_sales  |  format: #,0
Customers =
    CALCULATE(DISTINCTCOUNTNOBLANK(fact_sales[customer_id]), fact_sales[is_cancellation] = FALSE())

// Revenue / Orders.  |  home table: fact_sales  |  format: £#,0.00
Avg Order Value =
    DIVIDE([Revenue], [Orders])

// Units sold.  |  home table: fact_sales  |  format: #,0
Units =
    CALCULATE(SUM(fact_sales[quantity]), fact_sales[is_cancellation] = FALSE())

// Share of the selected countries' revenue.  |  home table: fact_sales  |  format: 0.0%
Country Revenue Share =
    DIVIDE([Revenue], CALCULATE([Revenue], ALLSELECTED(dim_country[country])))

// ===== Time =====
// Revenue in the same period one year earlier.  |  home table: fact_sales  |  format: £#,0
Revenue PY =
    CALCULATE([Revenue], SAMEPERIODLASTYEAR(dim_date[date]))

// Change vs the same period last year; blank when there is no prior-year data.  |  home table: fact_sales  |  format: 0.0%
Revenue YoY % =
    VAR py = [Revenue PY]
    RETURN IF(NOT ISBLANK(py), DIVIDE([Revenue] - py, py))

// ===== Products =====
// Cumulative share of revenue from products earning at least as much as this one (80/20 curve).  |  home table: fact_sales  |  format: 0.0%
Pareto Cumulative % =
    VAR thisRevenue = [Revenue]
    VAR ranked = ADDCOLUMNS(ALLSELECTED(dim_product[stock_code]), "@rev", [Revenue])
    VAR running = SUMX(FILTER(ranked, [@rev] >= thisRevenue), [@rev])
    RETURN DIVIDE(running, SUMX(ranked, [@rev]))

// ===== Returns =====
// Value of cancelled product lines, as a positive number.  |  home table: fact_sales  |  format: £#,0
Cancelled Value =
    CALCULATE(-SUM(fact_sales[revenue]), fact_sales[is_cancellation] = TRUE())

// Cancelled value / gross product sales.  |  home table: fact_sales  |  format: 0.0%
Cancellation Rate =
    DIVIDE([Cancelled Value], [Revenue])

// Gross product sales minus cancellations.  |  home table: fact_sales  |  format: £#,0
Net Revenue =
    [Revenue] - [Cancelled Value]

// Units on cancelled lines, as a positive number.  |  home table: fact_sales  |  format: #,0
Units Cancelled =
    CALCULATE(-SUM(fact_sales[quantity]), fact_sales[is_cancellation] = TRUE())

// ===== Customers =====
// Customers with an RFM segment.  |  home table: dim_customer  |  format: #,0
Segment Customers =
    COUNTROWS(FILTER(dim_customer, NOT ISBLANK(dim_customer[segment])))

// Lifetime revenue of the customers in view.  |  home table: dim_customer  |  format: £#,0
Segment Revenue =
    SUM(dim_customer[monetary])

// Share of all segmented customers.  |  home table: dim_customer  |  format: 0.0%
Segment Customer Share =
    DIVIDE([Segment Customers], CALCULATE([Segment Customers], ALL(dim_customer[segment], dim_customer[segment_order])))

// Share of all segmented customers' revenue.  |  home table: dim_customer  |  format: 0.0%
Segment Revenue Share =
    DIVIDE([Segment Revenue], CALCULATE([Segment Revenue], ALL(dim_customer[segment], dim_customer[segment_order])))

// ===== Cohorts =====
// Returning customers / cohort size. Across cohorts this is the size-weighted average.  |  home table: cohort_retention  |  format: 0.0%
Retention % =
    DIVIDE(SUM(cohort_retention[customers]), SUM(cohort_retention[cohort_size]))
