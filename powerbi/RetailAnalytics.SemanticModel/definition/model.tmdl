model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","fact_sales","dim_date","dim_product","dim_customer","dim_country","cohort_retention","basket_rules","product_returns"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fact_sales
ref table dim_date
ref table dim_product
ref table dim_customer
ref table dim_country
ref table cohort_retention
ref table basket_rules
ref table product_returns
